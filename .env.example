# Server-side AI credentials. NEVER expose these to the browser or commit them.
PORT=8787
MIND_API_TOKEN=change-me-to-a-long-random-local-token

# Preferred provider: gemini | openrouter | deepseek | local | offline
MIND_AI_PROVIDER=offline
# Comma-separated list of providers allowed in Settings. Empty = all.
MIND_ALLOWED_PROVIDERS=gemini,openrouter,deepseek,local,offline

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional local OpenAI-compatible endpoint (no key sent to third parties)
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=llama3.1

# Request limits
MIND_RATE_LIMIT=30
MIND_RATE_WINDOW_MS=60000
MIND_MAX_CONTEXT_CHARS=24000
